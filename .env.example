# Copy this file to .env.local (git-ignored) and fill in your own values.
# Find them in the Supabase dashboard: click "Connect", or open Project Settings > API Keys.
# Use the publishable key (or the legacy anon key). Never put a secret or service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY
